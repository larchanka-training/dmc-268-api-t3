POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
OLLAMA_HOST=http://host.docker.internal:11434
EUROROUTER_BASE_URL=
EUROROUTER_API_KEYS=
EUROROUTER_MODEL=gpt-4o-mini
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITLAB_API_BASE_URL=https://gitlab.com/api/v4
GITLAB_TOKEN=
VCS_TIMEOUT_SECONDS=30
VCS_MAX_DIFF_TOKENS=32000
RECOVERY_INTERVAL_SECONDS=30
RECOVERY_STALE_AFTER_SECONDS=300

# Optional: throwaway PostgreSQL for tests/db (wipes its public schema); tests skip when unset
# TEST_DATABASE_URL=postgresql+psycopg://postgres:test@localhost:55432/postgres
# Optional: throwaway Redis for real-Redis tests (flushes the selected db); tests skip when unset
# TEST_REDIS_URL=redis://localhost:56379/0
