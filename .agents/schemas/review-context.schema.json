{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "base_sha",
    "head_sha",
    "merge_base_sha",
    "rules_version",
    "input_complete",
    "rules",
    "locations",
    "anchors"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "input_complete": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "version",
          "title",
          "description",
          "category",
          "severity",
          "instructions",
          "enabled"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "locations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "side",
          "line"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "side": {
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "side",
          "line"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "side": {
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
